        public static string DirectFunction(string Function, string parameters)
        {
            XmlDocument doc = new XmlDocument();
            doc.InnerXml = parameters;
            string xmlOut = "";
            try
            {
                elementParameters = doc.SelectSingleNode("Parameters");

                switch (Function)
                {
                    case "Send":
                        xmlOut = send();
                        break;
                }
            }
            catch (Exception e) { return "<Result><ResultType>Error</ResultType><ResultString>Error in function " + e.Message + "</ResultString></Result>"; };
            return xmlOut;
        }

